# ════════════════════════════════════════════════════════════════
# ERP Platform — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ════════════════════════════════════════════════════════════════

# ───── SUPABASE (frontend + backend) ─────
# Get from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

# ───── SUPABASE (backend / Vercel ONLY — never expose) ─────
SUPABASE_SERVICE_KEY=eyJhbGc...your-service-role-key

# ───── ANTHROPIC (Vercel ONLY — never expose) ─────
# Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ───── DOMAIN (optional) ─────
# Custom domain for review links. Defaults to window.location.origin.
# VITE_BASE_URL=https://your-domain.com

# ───── DEV MODE (optional) ─────
# Set to "true" to enable dev login buttons (Admin/Sales/Recruiter/Ana/Finance/Client).
# REMOVE for production deployments.
VITE_DEV_MODE=true

# ───── EMAILJS (optional — for client notifications) ─────
# Get from emailjs.com if you want automated email sends from the client form.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# ───── CLAUDE PROXY ORIGIN ALLOWLIST (optional) ─────
# Comma-separated list of additional allowed origins for /api/claude.
# Vercel preview + localhost + VERCEL_URL are auto-allowed.
# ALLOWED_ORIGIN=your-domain.com
